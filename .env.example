# ─────────────────────────────────────────────────────────────────────────────
# Social Handle Agent — environment template.
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. NEVER commit real secrets. All values below are
# placeholders or local-only defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# APP_ENV=development               # development | test | staging | production
#                                   # unset = inferred from NODE_ENV (production when NODE_ENV=production)

# mock = deterministic fixtures, clearly labelled "Simulated" in the UI (default outside production)
# live = real platform adapters; missing credentials yield explicit "unknown", never mock data
AVAILABILITY_PROVIDER_MODE=mock

# Server-enforced kill switch. When false, checks and creation-plan previews work,
# but creating account jobs is rejected before anything is enqueued.
# Even when true, every platform still requires explicit per-platform confirmation.
ACCOUNT_CREATION_ENABLED=false

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_MODE=dev                       # dev (email-only login, refused in production) | supabase
# SESSION_SECRET=                   # REQUIRED in staging/production: openssl rand -base64 48
#                                   # unset in development = random per-process secret
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=public-anon-key   # publishable key; used by the browser login page only

# ── Database (PostgreSQL / Supabase) ────────────────────────────────────────
# Replace every CHANGE_ME_* value before running `npm run db:setup`, e.g.:
#   openssl rand -hex 16        (URL-safe; 12+ chars required for APP_DB_PASSWORD)
# POSTGRES_PASSWORD is the local superuser password (also read by docker-compose.yml).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# App connection: least-privilege role subject to row-level security.
DATABASE_URL=postgres://sha_app_login:CHANGE_ME_APP_DB_PASSWORD@localhost:5432/social_handle_agent
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD  # used by `npm run db:bootstrap` to create the app login role
# Schema owner, used ONLY by migrations/seed. Never used by the running app.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/social_handle_agent
# Superuser/admin, used ONLY by `npm run db:bootstrap` (creates roles + databases).
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/postgres

# Optional: integration tests (RLS isolation). Skipped when unset. To enable, uncomment and run
#   npx tsx packages/db/src/cli/migrate.ts --test && npx tsx packages/db/src/cli/seed.ts --test
# TEST_DATABASE_URL=postgres://sha_app_login:CHANGE_ME_APP_DB_PASSWORD@localhost:5432/social_handle_agent_test
# TEST_MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/social_handle_agent_test
# TEST_REDIS_URL=redis://localhost:6379/15   # optional: BullMQ round-trip test (uses DB 15)

# ── Queue / cache ───────────────────────────────────────────────────────────
QUEUE_DRIVER=inline                 # inline (in-process, dev) | bullmq (durable, needs Redis + `npm run worker`)
CACHE_DRIVER=memory                 # memory | redis
# REDIS_URL=redis://localhost:6379

# ── Rate limiting ───────────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the app (e.g. 1 on Vercel/Fly/behind nginx).
# 0 = ignore X-Forwarded-For (it is client-controlled); per-user/workspace limits still apply.
TRUSTED_PROXY_HOPS=0

# ── Availability tuning ─────────────────────────────────────────────────────
AVAILABILITY_CACHE_TTL_SECONDS=300
CHECK_DEADLINE_MS=20000
CHECK_CONCURRENCY=8

# ── Credential vault (envelope encryption; reserved for future OAuth tokens) ─
# CREDENTIAL_MASTER_KEY=base64-of-32-random-bytes   # openssl rand -base64 32

# ── Live availability adapters (server-side only; only read when mode=live) ──
# Having these set does NOT authorize account registration.
# X_BEARER_TOKEN=                   # X API v2 (paid tier) — user lookup
# YOUTUBE_API_KEY=                  # YouTube Data API v3 — channels?forHandle
# REDDIT_CLIENT_ID=                 # Reddit "script"/web app, app-only OAuth
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:social-handle-agent:0.1 (by /u/your_reddit_user)
# META_GRAPH_ACCESS_TOKEN=          # Instagram Business Discovery (confirms "taken" only)
# META_IG_BUSINESS_ACCOUNT_ID=
# META_GRAPH_API_VERSION=v23.0
