{
  "name": "social-handle-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @sha/web",
    "build": "npm run build -w @sha/web",
    "start": "npm run start -w @sha/web",
    "worker": "tsx packages/queue/src/worker-main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @sha/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @sha/web",
    "db:bootstrap": "tsx packages/db/src/cli/bootstrap.ts",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:seed": "tsx packages/db/src/cli/seed.ts",
    "db:setup": "npm run db:bootstrap && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
